      '<button type="button" class="btn" onclick="this.closest(\'.plr-dir-block\').remove()">Remove</button>' +
    '</div>' +
    '<div class="plr-plexpath-row">' +
      '<label>Plex\'s own path for this folder:</label>' +
      '<input type="text" name="dir_plex_path[]" placeholder="leave blank if identical to the path above">' +
    '</div>';
  container.appendChild(block);
}
</script>
