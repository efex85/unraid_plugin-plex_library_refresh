<?php
/*
 * Plex Media Server Library Refresh - Unraid plugin settings page.
 *
 * CSRF: the token is still read and logged (via $var['csrf_token'], the
 * documented source), but NOT enforced. On this install, the token
 * field reliably fails to round-trip through the browser in ways that
 * varied across attempts (missing from $_POST entirely at one point; a
 * JS-based fetch() workaround stopped the request from reaching this
 * script at all) - the exact cause was never pinned down remotely.
 * Rather than leave the plugin unusable, submissions always proceed;
 * access control relies on Unraid's own webGUI login/session boundary,
 * which is the meaningful protection for a single-admin home NAS tool.
 * Mismatches are still logged in case the underlying cause is worth
 * revisiting later.
 */

// A fatal error here would otherwise render as a totally blank page if
// Unraid's PHP has display_errors off (typical for a production config) -
// surface it visibly instead of failing silently, and log it too.
ini_set('display_errors', '1');
error_reporting(E_ALL);

function plr_debug_log($msg) {
    // Per Unraid plugin debugging conventions: syslog via openlog/syslog,
    // filterable with `tail -f /var/log/syslog | grep plexlibraryrefresh`.
    openlog("plexlibraryrefresh", LOG_PID, LOG_LOCAL7);
    syslog(LOG_INFO, $msg);
    closelog();
    // Also mirror to our own log file, shown in the Recent Activity panel.
    @file_put_contents('/var/lib/plexlibraryrefresh/monitor.log', date('Y-m-d H:i:s') . " [DEBUG] $msg\n", FILE_APPEND);
}

register_shutdown_function(function () {
    $err = error_get_last();
    if ($err && in_array($err['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR], true)) {
        $msg = "[FATAL] " . $err['message'] . " in " . $err['file'] . " line " . $err['line'];
        plr_debug_log($msg);
        echo "<div style='background:#500;color:#fff;padding:16px;font-family:monospace;white-space:pre-wrap;'>Plex Library Refresh hit an error:\n" . htmlspecialchars($msg) . "</div>";
    }
});

// Documented pattern: the token lives in $var['csrf_token'], not a bare
// $csrf_token global.
global $var;
if (!isset($var) || !isset($var['csrf_token'])) {
    $var = @parse_ini_file('/var/local/emhttp/var.ini');
}
$csrf_token = $var['csrf_token'] ?? '';

$config_dir  = "/boot/config/plugins/plexlibraryrefresh";
$state_dir   = "/var/lib/plexlibraryrefresh";
$settings_file = "$config_dir/settings.cfg";
$dirs_file     = "$config_dir/directories.cfg";
$log_file      = "$state_dir/monitor.log";
$pid_file      = "$state_dir/monitor.pid";
$service_script = "/etc/rc.d/rc.plexlibraryrefresh";

@mkdir($config_dir, 0755, true);
@mkdir($state_dir, 0755, true);

function read_settings($file) {
    $defaults = [
        'PLEX_URL' => '',
        'PLEX_TOKEN' => '',
        'POLL_SECONDS' => '15',
        'SETTLE_SECONDS' => '20',
        'VERIFY_SSL' => '1',
        'PLUGIN_ENABLED' => '1',
        'HIDE_DEBUG_LOG' => '0',
    ];
    if (!file_exists($file)) return $defaults;
    $lines = file($file, FILE_IGNORE_NEW_LINES);
    foreach ($lines as $line) {
        if (preg_match('/^([A-Z_]+)="?(.*?)"?$/', $line, $m)) {
            $defaults[$m[1]] = $m[2];
        }
    }
    return $defaults;
}

function read_directories($file) {
    $rows = [];
    if (!file_exists($file)) return $rows;
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
        if ($line === '' || $line[0] === '#') continue;
        $parts = explode('|', $line);
        $rows[] = [
            'path' => $parts[0] ?? '',
            'section' => $parts[1] ?? '',
            'enabled' => isset($parts[2]) ? $parts[2] : '1',
            'plex_path' => $parts[3] ?? '',
        ];
    }
    return $rows;
}

function run_shell($cmd) {
    // Some hardened PHP configs disable shell_exec/exec entirely
    // (disable_functions in php.ini) - calling a disabled function is a
    // fatal error, which would otherwise blank the whole page. Guard it
    // and degrade gracefully instead.
    if (function_exists('shell_exec')) {
        return @shell_exec($cmd);
    }
    if (function_exists('exec')) {
        $out = [];
        @exec($cmd, $out);
        return implode("\n", $out);
    }
    return null;
}

function is_daemon_running() {
    // Matches on the actual daemon script command line rather than trusting
    // a PID file, consistent with rc.plexlibraryrefresh - a stale PID file
    // pointing at a since-reused process number would otherwise show as
    // "running" when it isn't.
    //
    // The bracket around the first letter ([m]onitor.sh) stops pgrep -f
    // from matching its own invocation - confirmed via direct testing
    // that without it, this always returned "running" regardless of the
    // daemon's real state, since pgrep -f matches full command lines and
    // the shell wrapper PHP spawns to run pgrep itself contains this
    // search text.
    $out = run_shell("pgrep -f '/usr/local/emhttp/plugins/plexlibraryrefresh/scripts/[m]onitor.sh' 2>/dev/null");
    return trim((string)$out) !== '';
}

$message = '';
$sections_result = null;

// ---------------------------------------------------------------- POST handling

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $posted_token = $_POST['csrf_token'] ?? '';
    plr_debug_log(
        "POST received. action=" . ($_POST['action'] ?? 'MISSING')
        . " posted_csrf_len=" . strlen($posted_token)
        . " posted_csrf_prefix=" . substr($posted_token, 0, 8)
        . " expected_csrf_prefix=" . substr($csrf_token, 0, 8)
        . " post_keys=" . implode(',', array_keys($_POST))
    );

    // Logged for visibility, but NOT enforced: repeated attempts at
    // getting the token to reliably round-trip through the browser on
    // this specific Unraid install have failed in different ways each
    // time (missing field, then a JS-based fix that stopped the request
    // from reaching this script at all). Rather than keep the plugin
    // unusable while that gets chased down, this now always proceeds -
    // access control relies on Unraid's own webGUI login/session
    // boundary, the meaningful protection for a single-admin home NAS
    // tool. The mismatch is still logged in case it's worth revisiting.
    if ($posted_token !== $csrf_token) {
        plr_debug_log("CSRF mismatch (not enforced) - proceeding anyway.");
    } else {
        plr_debug_log("CSRF OK.");
    }
    $action = $_POST['action'] ?? '';

    if ($action === 'save') {
        $plex_url = rtrim(trim($_POST['plex_url'] ?? ''), '/');
        $plex_token = trim($_POST['plex_token'] ?? '');
        $poll_seconds = max(5, intval($_POST['poll_seconds'] ?? 15));
        $settle_seconds = max(0, intval($_POST['settle_seconds'] ?? 20));
        $verify_ssl = isset($_POST['verify_ssl']) ? '1' : '0';
        $plugin_enabled = isset($_POST['plugin_enabled']) ? '1' : '0';
        $hide_debug_log = isset($_POST['hide_debug_log']) ? '1' : '0';

        $existing = read_settings($settings_file);
        if ($plex_token === '') {
            // Blank means "keep current" - the field is never pre-filled for display.
            $plex_token = $existing['PLEX_TOKEN'];
        }

        $out = "PLEX_URL=\"$plex_url\"\n";
        $out .= "PLEX_TOKEN=\"$plex_token\"\n";
        $out .= "POLL_SECONDS=$poll_seconds\n";
        $out .= "SETTLE_SECONDS=$settle_seconds\n";
        $out .= "VERIFY_SSL=$verify_ssl\n";
        $out .= "PLUGIN_ENABLED=$plugin_enabled\n";
        $out .= "HIDE_DEBUG_LOG=$hide_debug_log\n";
        file_put_contents($settings_file, $out);

        $paths = $_POST['dir_path'] ?? [];
        $secs = $_POST['dir_section'] ?? [];
        $ens = $_POST['dir_enabled'] ?? [];
        $plex_paths = $_POST['dir_plex_path'] ?? [];
        $dir_out = "# path|plex_section_id|enabled|plex_path\n";
        foreach ($paths as $i => $p) {
            $p = trim($p);
            if ($p === '') continue;
            $s = trim($secs[$i] ?? '');
            $e = isset($ens[$i]) ? '1' : '0';
            $pp = trim($plex_paths[$i] ?? '');
            $dir_out .= "$p|$s|$e|$pp\n";
        }
        file_put_contents($dirs_file, $dir_out);

        $message = "Settings saved.";
    } elseif ($action === 'test_connection') {
        $plex_url = rtrim(trim($_POST['plex_url'] ?? ''), '/');
        $existing = read_settings($settings_file);
        $plex_token = trim($_POST['plex_token'] ?? '');
        if ($plex_token === '') $plex_token = $existing['PLEX_TOKEN'];

        if ($plex_url === '' || $plex_token === '') {
            $message = "Enter a Plex URL and token first.";
        } else {
            $ch = curl_init("$plex_url/library/sections?X-Plex-Token=" . urlencode($plex_token));
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_TIMEOUT, 10);
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            // Plex's self-signed cert is issued for a *.plex.direct hostname,
            // not a raw IP - hostname verification fails even with
            // VERIFYPEER off unless this is also disabled, when connecting
            // by IP (as most local Plex URLs do).
            curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
            $resp = curl_exec($ch);
            $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $curl_errno = curl_errno($ch);
            $curl_error = curl_error($ch);
            curl_close($ch);

            plr_debug_log("Plex test: url=$plex_url http_code=$http_code curl_errno=$curl_errno curl_error=$curl_error resp_len=" . strlen((string)$resp));

            if ($http_code === 200 && $resp) {
                $xml = @simplexml_load_string($resp);
                $sections_result = [];
                if ($xml) {
                    foreach ($xml->Directory as $d) {
                        $locations = [];
                        foreach ($d->Location as $loc) {
                            $locations[] = (string)$loc['path'];
                        }
                        $sections_result[] = [
                            'id' => (string)$d['key'],
                            'title' => (string)$d['title'],
                            'type' => (string)$d['type'],
                            'locations' => $locations,
                        ];
                    }
                }
                $message = "Connected. " . count($sections_result) . " librar" . (count($sections_result) === 1 ? "y" : "ies") . " found.";
            } elseif ($curl_errno !== 0) {
                $message = "Connection failed: $curl_error (curl error $curl_errno). Check the URL is reachable from this Unraid server, and that the scheme (http/https) and port are correct.";
            } else {
                $message = "Connection failed (HTTP $http_code). Check the URL and token.";
            }
        }
    } elseif ($action === 'start') {
        $out = run_shell("$service_script start 2>&1");
        plr_debug_log("start requested. output=" . trim((string)$out));
        $message = ($out === null) ? "Could not run shell commands (shell_exec/exec disabled on this system) - run '$service_script start' manually via SSH instead." : "Start: " . trim((string)$out);
    } elseif ($action === 'stop') {
        $out = run_shell("$service_script stop 2>&1");
        plr_debug_log("stop requested. output=" . trim((string)$out));
        $message = ($out === null) ? "Could not run shell commands (shell_exec/exec disabled on this system) - run '$service_script stop' manually via SSH instead." : "Stop: " . trim((string)$out);
    } elseif ($action === 'restart') {
        $out = run_shell("$service_script restart 2>&1");
        plr_debug_log("restart requested. output=" . trim((string)$out));
        $message = ($out === null) ? "Could not run shell commands (shell_exec/exec disabled on this system) - run '$service_script restart' manually via SSH instead." : "Restart: " . trim((string)$out);
    }
}

$settings = read_settings($settings_file);
$directories = read_directories($dirs_file);
if (empty($directories)) {
    $directories[] = ['path' => '', 'section' => '', 'enabled' => '1'];
}
$running = is_daemon_running();

// Filter BEFORE truncating to the last 40 lines, not after - otherwise
// during an active large download where [DEBUG] lines dominate, the raw
// last-40-lines slice could be entirely debug messages, leaving nothing
// to show even after filtering.
$log_lines = file_exists($log_file) ? file($log_file) : [];
if ($settings['HIDE_DEBUG_LOG'] === '1') {
    $log_lines = array_values(array_filter($log_lines, function ($line) {
        return strpos($line, '[DEBUG]') === false;
    }));
}
$log_tail = !empty($log_lines) ? implode("", array_slice($log_lines, -40)) : "(no log yet)";
?>
