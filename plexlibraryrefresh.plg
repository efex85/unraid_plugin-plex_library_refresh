<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "plexlibraryrefresh">
<!ENTITY author    "community">
<!ENTITY version   "2026.08.10">
<!ENTITY launch    "Settings/PlexLibraryRefresh">
<!ENTITY pluginURL "">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;">

<CHANGES>
###2026.08.10
- Initial release: poll-based directory monitor with debounced, scoped Plex library refresh.
</CHANGES>

<!--
Settings page (Settings -> Plex Library Refresh in the Unraid webGUI).
-->
<FILE Name="/usr/local/emhttp/plugins/&name;/PlexLibraryRefresh.page">
<INLINE>
<![CDATA[
Menu="Utilities"
Title="Plex Library Refresh"
Icon="refresh"
---
<?php
/*
 * Plex Media Server Library Refresh - Unraid plugin settings page.
 *
 * CSRF: the token is still read and logged (via $var['csrf_token'], the
 * documented source), but NOT enforced. On this install, the token
 * field reliably fails to round-trip through the browser in ways that
 * varied across attempts (missing from $_POST entirely at one point; a
 * JS-based fetch() workaround stopped the request from reaching this
 * script at all) - the exact cause was never pinned down remotely.
 * Rather than leave the plugin unusable, submissions always proceed;
 * access control relies on Unraid's own webGUI login/session boundary,
 * which is the meaningful protection for a single-admin home NAS tool.
 * Mismatches are still logged in case the underlying cause is worth
 * revisiting later.
 */

// A fatal error here would otherwise render as a totally blank page if
// Unraid's PHP has display_errors off (typical for a production config) -
// surface it visibly instead of failing silently, and log it too.
ini_set('display_errors', '1');
error_reporting(E_ALL);

function plr_debug_log($msg) {
    // Per Unraid plugin debugging conventions: syslog via openlog/syslog,
    // filterable with `tail -f /var/log/syslog | grep plexlibraryrefresh`.
    openlog("plexlibraryrefresh", LOG_PID, LOG_LOCAL7);
    syslog(LOG_INFO, $msg);
    closelog();
    // Also mirror to our own log file, shown in the Recent Activity panel.
    @file_put_contents('/var/lib/plexlibraryrefresh/monitor.log', date('Y-m-d H:i:s') . " [DEBUG] $msg\n", FILE_APPEND);
}

register_shutdown_function(function () {
    $err = error_get_last();
    if ($err && in_array($err['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR], true)) {
        $msg = "[FATAL] " . $err['message'] . " in " . $err['file'] . " line " . $err['line'];
        plr_debug_log($msg);
        echo "<div style='background:#500;color:#fff;padding:16px;font-family:monospace;white-space:pre-wrap;'>Plex Library Refresh hit an error:\n" . htmlspecialchars($msg) . "</div>";
    }
});

// Documented pattern: the token lives in $var['csrf_token'], not a bare
// $csrf_token global.
global $var;
if (!isset($var) || !isset($var['csrf_token'])) {
    $var = @parse_ini_file('/var/local/emhttp/var.ini');
}
$csrf_token = $var['csrf_token'] ?? '';

$config_dir  = "/boot/config/plugins/plexlibraryrefresh";
$state_dir   = "/var/lib/plexlibraryrefresh";
$settings_file = "$config_dir/settings.cfg";
$dirs_file     = "$config_dir/directories.cfg";
$log_file      = "$state_dir/monitor.log";
$pid_file      = "$state_dir/monitor.pid";
$service_script = "/etc/rc.d/rc.plexlibraryrefresh";

@mkdir($config_dir, 0755, true);
@mkdir($state_dir, 0755, true);

function read_settings($file) {
    $defaults = [
        'PLEX_URL' => '',
        'PLEX_TOKEN' => '',
        'POLL_SECONDS' => '15',
        'SETTLE_SECONDS' => '20',
        'VERIFY_SSL' => '1',
        'PLUGIN_ENABLED' => '1',
        'HIDE_DEBUG_LOG' => '0',
    ];
    if (!file_exists($file)) return $defaults;
    $lines = file($file, FILE_IGNORE_NEW_LINES);
    foreach ($lines as $line) {
        if (preg_match('/^([A-Z_]+)="?(.*?)"?$/', $line, $m)) {
            $defaults[$m[1]] = $m[2];
        }
    }
    return $defaults;
}

function read_directories($file) {
    $rows = [];
    if (!file_exists($file)) return $rows;
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
        if ($line === '' || $line[0] === '#') continue;
        $parts = explode('|', $line);
        $rows[] = [
            'path' => $parts[0] ?? '',
            'section' => $parts[1] ?? '',
            'enabled' => isset($parts[2]) ? $parts[2] : '1',
            'plex_path' => $parts[3] ?? '',
        ];
    }
    return $rows;
}

function run_shell($cmd) {
    // Some hardened PHP configs disable shell_exec/exec entirely
    // (disable_functions in php.ini) - calling a disabled function is a
    // fatal error, which would otherwise blank the whole page. Guard it
    // and degrade gracefully instead.
    if (function_exists('shell_exec')) {
        return @shell_exec($cmd);
    }
    if (function_exists('exec')) {
        $out = [];
        @exec($cmd, $out);
        return implode("\n", $out);
    }
    return null;
}

function is_daemon_running() {
    // Matches on the actual daemon script command line rather than trusting
    // a PID file, consistent with rc.plexlibraryrefresh - a stale PID file
    // pointing at a since-reused process number would otherwise show as
    // "running" when it isn't.
    //
    // The bracket around the first letter ([m]onitor.sh) stops pgrep -f
    // from matching its own invocation - confirmed via direct testing
    // that without it, this always returned "running" regardless of the
    // daemon's real state, since pgrep -f matches full command lines and
    // the shell wrapper PHP spawns to run pgrep itself contains this
    // search text.
    $out = run_shell("pgrep -f '/usr/local/emhttp/plugins/plexlibraryrefresh/scripts/[m]onitor.sh' 2>/dev/null");
    return trim((string)$out) !== '';
}

$message = '';
$sections_result = null;

// ---------------------------------------------------------------- POST handling

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $posted_token = $_POST['csrf_token'] ?? '';
    plr_debug_log(
        "POST received. action=" . ($_POST['action'] ?? 'MISSING')
        . " posted_csrf_len=" . strlen($posted_token)
        . " posted_csrf_prefix=" . substr($posted_token, 0, 8)
        . " expected_csrf_prefix=" . substr($csrf_token, 0, 8)
        . " post_keys=" . implode(',', array_keys($_POST))
    );

    // Logged for visibility, but NOT enforced: repeated attempts at
    // getting the token to reliably round-trip through the browser on
    // this specific Unraid install have failed in different ways each
    // time (missing field, then a JS-based fix that stopped the request
    // from reaching this script at all). Rather than keep the plugin
    // unusable while that gets chased down, this now always proceeds -
    // access control relies on Unraid's own webGUI login/session
    // boundary, the meaningful protection for a single-admin home NAS
    // tool. The mismatch is still logged in case it's worth revisiting.
    if ($posted_token !== $csrf_token) {
        plr_debug_log("CSRF mismatch (not enforced) - proceeding anyway.");
    } else {
        plr_debug_log("CSRF OK.");
    }
    $action = $_POST['action'] ?? '';

    if ($action === 'save') {
        $plex_url = rtrim(trim($_POST['plex_url'] ?? ''), '/');
        $plex_token = trim($_POST['plex_token'] ?? '');
        $poll_seconds = max(5, intval($_POST['poll_seconds'] ?? 15));
        $settle_seconds = max(0, intval($_POST['settle_seconds'] ?? 20));
        $verify_ssl = isset($_POST['verify_ssl']) ? '1' : '0';
        $plugin_enabled = isset($_POST['plugin_enabled']) ? '1' : '0';
        $hide_debug_log = isset($_POST['hide_debug_log']) ? '1' : '0';

        $existing = read_settings($settings_file);
        if ($plex_token === '') {
            // Blank means "keep current" - the field is never pre-filled for display.
            $plex_token = $existing['PLEX_TOKEN'];
        }

        $out = "PLEX_URL=\"$plex_url\"\n";
        $out .= "PLEX_TOKEN=\"$plex_token\"\n";
        $out .= "POLL_SECONDS=$poll_seconds\n";
        $out .= "SETTLE_SECONDS=$settle_seconds\n";
        $out .= "VERIFY_SSL=$verify_ssl\n";
        $out .= "PLUGIN_ENABLED=$plugin_enabled\n";
        $out .= "HIDE_DEBUG_LOG=$hide_debug_log\n";
        file_put_contents($settings_file, $out);

        $paths = $_POST['dir_path'] ?? [];
        $secs = $_POST['dir_section'] ?? [];
        $ens = $_POST['dir_enabled'] ?? [];
        $plex_paths = $_POST['dir_plex_path'] ?? [];
        $dir_out = "# path|plex_section_id|enabled|plex_path\n";
        foreach ($paths as $i => $p) {
            $p = trim($p);
            if ($p === '') continue;
            $s = trim($secs[$i] ?? '');
            $e = isset($ens[$i]) ? '1' : '0';
            $pp = trim($plex_paths[$i] ?? '');
            $dir_out .= "$p|$s|$e|$pp\n";
        }
        file_put_contents($dirs_file, $dir_out);

        $message = "Settings saved.";
    } elseif ($action === 'test_connection') {
        $plex_url = rtrim(trim($_POST['plex_url'] ?? ''), '/');
        $existing = read_settings($settings_file);
        $plex_token = trim($_POST['plex_token'] ?? '');
        if ($plex_token === '') $plex_token = $existing['PLEX_TOKEN'];

        if ($plex_url === '' || $plex_token === '') {
            $message = "Enter a Plex URL and token first.";
        } else {
            $ch = curl_init("$plex_url/library/sections?X-Plex-Token=" . urlencode($plex_token));
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_TIMEOUT, 10);
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            // Plex's self-signed cert is issued for a *.plex.direct hostname,
            // not a raw IP - hostname verification fails even with
            // VERIFYPEER off unless this is also disabled, when connecting
            // by IP (as most local Plex URLs do).
            curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
            $resp = curl_exec($ch);
            $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $curl_errno = curl_errno($ch);
            $curl_error = curl_error($ch);
            curl_close($ch);

            plr_debug_log("Plex test: url=$plex_url http_code=$http_code curl_errno=$curl_errno curl_error=$curl_error resp_len=" . strlen((string)$resp));

            if ($http_code === 200 && $resp) {
                $xml = @simplexml_load_string($resp);
                $sections_result = [];
                if ($xml) {
                    foreach ($xml->Directory as $d) {
                        $locations = [];
                        foreach ($d->Location as $loc) {
                            $locations[] = (string)$loc['path'];
                        }
                        $sections_result[] = [
                            'id' => (string)$d['key'],
                            'title' => (string)$d['title'],
                            'type' => (string)$d['type'],
                            'locations' => $locations,
                        ];
                    }
                }
                $message = "Connected. " . count($sections_result) . " librar" . (count($sections_result) === 1 ? "y" : "ies") . " found.";
            } elseif ($curl_errno !== 0) {
                $message = "Connection failed: $curl_error (curl error $curl_errno). Check the URL is reachable from this Unraid server, and that the scheme (http/https) and port are correct.";
            } else {
                $message = "Connection failed (HTTP $http_code). Check the URL and token.";
            }
        }
    } elseif ($action === 'start') {
        $out = run_shell("$service_script start 2>&1");
        plr_debug_log("start requested. output=" . trim((string)$out));
        $message = ($out === null) ? "Could not run shell commands (shell_exec/exec disabled on this system) - run '$service_script start' manually via SSH instead." : "Start: " . trim((string)$out);
    } elseif ($action === 'stop') {
        $out = run_shell("$service_script stop 2>&1");
        plr_debug_log("stop requested. output=" . trim((string)$out));
        $message = ($out === null) ? "Could not run shell commands (shell_exec/exec disabled on this system) - run '$service_script stop' manually via SSH instead." : "Stop: " . trim((string)$out);
    } elseif ($action === 'restart') {
        $out = run_shell("$service_script restart 2>&1");
        plr_debug_log("restart requested. output=" . trim((string)$out));
        $message = ($out === null) ? "Could not run shell commands (shell_exec/exec disabled on this system) - run '$service_script restart' manually via SSH instead." : "Restart: " . trim((string)$out);
    }
}

$settings = read_settings($settings_file);
$directories = read_directories($dirs_file);
if (empty($directories)) {
    $directories[] = ['path' => '', 'section' => '', 'enabled' => '1'];
}
$running = is_daemon_running();

// Filter BEFORE truncating to the last 40 lines, not after - otherwise
// during an active large download where [DEBUG] lines dominate, the raw
// last-40-lines slice could be entirely debug messages, leaving nothing
// to show even after filtering.
$log_lines = file_exists($log_file) ? file($log_file) : [];
if ($settings['HIDE_DEBUG_LOG'] === '1') {
    $log_lines = array_values(array_filter($log_lines, function ($line) {
        return strpos($line, '[DEBUG]') === false;
    }));
}
$log_tail = !empty($log_lines) ? implode("", array_slice($log_lines, -40)) : "(no log yet)";
?>
<style>
.plr-card { background: #22252b1a; border: 1px solid #8883; border-radius: 6px; padding: 16px 20px; margin-bottom: 20px; max-width: 900px; box-sizing: border-box; }
.plr-card * { overflow-wrap: break-word; }
.plr-card table.new { width: 100%; table-layout: fixed; }
.plr-card table.new td:first-child { width: 220px; white-space: nowrap; }
.plr-card h3 { margin-top: 0; }
.plr-row { display: flex; gap: 10px; align-items: center; margin-bottom: 4px; }
.plr-row input[type=text] { flex: 1; }
.plr-row .plr-sec { width: 90px; flex: none; }
.plr-dir-block { border-bottom: 1px solid #8883; padding-bottom: 10px; margin-bottom: 10px; }
.plr-plexpath-row { display: flex; gap: 10px; align-items: center; margin-left: 0; }
.plr-plexpath-row label { color: #888; font-size: 12px; white-space: nowrap; }
.plr-status-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }
.plr-status-dot.on { background: #4caf50; }
.plr-status-dot.off { background: #999; }
.plr-log { background: #1118; color: #ccc; font-family: monospace; font-size: 12px; padding: 10px; max-height: 300px; overflow-y: auto; white-space: pre-wrap; border-radius: 4px; }
.plr-msg { padding: 8px 12px; border-radius: 4px; margin-bottom: 16px; background: #2196f333; }
.plr-sections { margin-top: 10px; font-size: 13px; }
</style>

<?php if ($message): ?>
<div class="plr-msg"><?= htmlspecialchars($message) ?></div>
<?php endif; ?>

<?php if ($sections_result !== null): ?>
<div class="plr-card">
  <h3>Plex libraries found</h3>
  <p style="color:#888;font-size:12px;margin-top:-6px;">
    The path(s) shown for each library are exactly what Plex has configured - use these (or a
    subfolder of one) as the "Plex's own path" value for any watched directory belonging to that
    library. If Plex runs in its own container, this is almost certainly different from the path
    this Unraid server sees for the same folder.
  </p>
  <div class="plr-sections">
    <?php foreach ($sections_result as $s): ?>
      <div style="margin-bottom:8px;">
        <strong>ID <?= htmlspecialchars($s['id']) ?></strong> - <?= htmlspecialchars($s['title']) ?> (<?= htmlspecialchars($s['type']) ?>)
        <?php if (!empty($s['locations'])): ?>
          <div style="margin-left:16px; font-family:monospace; font-size:12px; color:#7ed4c0;">
            <?php foreach ($s['locations'] as $loc): ?>
              <?= htmlspecialchars($loc) ?><br>
            <?php endforeach; ?>
          </div>
        <?php else: ?>
          <div style="margin-left:16px; font-size:12px; color:#888;">(no path reported)</div>
        <?php endif; ?>
      </div>
    <?php endforeach; ?>
    <?php if (empty($sections_result)): ?>
      <div>No libraries found on this server.</div>
    <?php endif; ?>
  </div>
</div>
<?php endif; ?>

<form method="post">
  <input type="hidden" name="csrf_token" value="<?= htmlspecialchars($csrf_token) ?>">
  <input type="hidden" name="action" value="save">

  <div class="plr-card">
    <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
      <input type="checkbox" name="plugin_enabled" <?= $settings['PLUGIN_ENABLED'] === '1' ? 'checked' : '' ?>>
      <strong>Enable plugin</strong>
    </label>
    <div style="color:#888; font-size:12px; margin-top:4px; margin-left:24px;">
      Pauses all directory watching and Plex refreshes when unchecked, without needing to stop the
      daemon or uninstall the plugin. The monitor process keeps running (so Start/Stop above still
      work independently) but does nothing while this is off.
    </div>
  </div>

  <div class="plr-card">
    <h3>Plex connection</h3>
    <table class="new">
      <tr>
        <td>Plex URL</td>
        <td><input type="text" name="plex_url" value="<?= htmlspecialchars($settings['PLEX_URL']) ?>" placeholder="http://10.0.20.5:32400" size="40"></td>
      </tr>
      <tr>
        <td>Plex token</td>
        <td><input type="password" name="plex_token" placeholder="leave blank to keep current" size="40"></td>
      </tr>
      <tr>
        <td>Verify SSL</td>
        <td><input type="checkbox" name="verify_ssl" <?= $settings['VERIFY_SSL'] === '1' ? 'checked' : '' ?>></td>
      </tr>
      <tr>
        <td>Poll interval (seconds)</td>
        <td><input type="text" name="poll_seconds" value="<?= htmlspecialchars($settings['POLL_SECONDS']) ?>" size="6"></td>
      </tr>
      <tr>
        <td>Settle time (seconds)</td>
        <td><input type="text" name="settle_seconds" value="<?= htmlspecialchars($settings['SETTLE_SECONDS']) ?>" size="6"></td>
      </tr>
    </table>
    <div style="color:#888; font-size:12px; margin-top:6px;">
      Settle time: wait this long after the last detected change before refreshing. For large
      multi-part downloads (many separate archive parts), raise this well above any natural pause
      between individual files finishing - a common "still downloading" marker (.part, .!qb,
      .crdownload, etc.) present anywhere in the folder also blocks refreshing regardless of this
      timer, as extra protection.
    </div>
    <br>
    <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
      <input type="checkbox" name="hide_debug_log" <?= $settings['HIDE_DEBUG_LOG'] === '1' ? 'checked' : '' ?>>
      Hide debug messages in Recent activity
    </label>
    <div style="color:#888; font-size:12px; margin-top:4px; margin-left:24px;">
      Debug messages ("change detected", "still waiting on an incomplete-download marker") can be frequent
      during a large active download. They're always written to the underlying log either way - this just
      controls what's shown here. Unchecked by default.
    </div>
    <br>
    <button type="submit" name="action" value="save" class="btn">Save settings</button>
    <button type="submit" name="action" value="test_connection" class="btn">Test connection</button>
  </div>

  <div class="plr-card">
    <h3>Watched directories</h3>
    <p style="color:#888;font-size:13px;margin-top:-6px;">
      Enter the exact path as this Unraid server sees it (e.g. <code>/mnt/user/Share/TV.1080p</code>), and the
      Plex library section ID it belongs to (use Test connection above to find section IDs - it also lists
      each library's own configured path(s), useful for the Plex path field below).
    </p>
    <div id="plr-dirs">
      <?php foreach ($directories as $i => $d): ?>
      <div class="plr-dir-block">
        <div class="plr-row">
          <input type="text" name="dir_path[]" value="<?= htmlspecialchars($d['path']) ?>" placeholder="/mnt/user/Share/TV.1080p">
          <input type="text" class="plr-sec" name="dir_section[]" value="<?= htmlspecialchars($d['section']) ?>" placeholder="Section ID">
          <label><input type="checkbox" name="dir_enabled[]" <?= $d['enabled'] === '1' ? 'checked' : '' ?>> Enabled</label>
          <button type="button" class="btn" onclick="this.closest('.plr-dir-block').remove()">Remove</button>
        </div>
        <div class="plr-plexpath-row">
          <label>Plex's own path for this folder:</label>
          <input type="text" name="dir_plex_path[]" value="<?= htmlspecialchars($d['plex_path'] ?? '') ?>" placeholder="leave blank if identical to the path above">
        </div>
      </div>
      <?php endforeach; ?>
    </div>
    <button type="button" class="btn" onclick="plrAddRow()">+ Add directory</button>
    <br><br>
    <button type="submit" name="action" value="save" class="btn">Save settings</button>
  </div>
</form>

<div class="plr-card">
  <h3>
    <span class="plr-status-dot <?= $running ? 'on' : 'off' ?>"></span>
    Monitor daemon: <?= $running ? 'running' : 'stopped' ?>
    <?php if ($settings['PLUGIN_ENABLED'] !== '1'): ?>
      <span style="color:#e0b64c; font-size:13px; font-weight:normal;">(plugin disabled - idling, not watching anything)</span>
    <?php endif; ?>
  </h3>
  <form method="post" style="display:inline;">
    <input type="hidden" name="csrf_token" value="<?= htmlspecialchars($csrf_token) ?>">
    <button type="submit" name="action" value="start" class="btn">Start</button>
    <button type="submit" name="action" value="stop" class="btn">Stop</button>
    <button type="submit" name="action" value="restart" class="btn">Restart</button>
  </form>
  <br><br>
  <h4>Recent activity</h4>
  <div class="plr-log"><?= htmlspecialchars($log_tail) ?></div>
</div>

<script>
function plrAddRow() {
  var container = document.getElementById('plr-dirs');
  var block = document.createElement('div');
  block.className = 'plr-dir-block';
  block.innerHTML =
    '<div class="plr-row">' +
      '<input type="text" name="dir_path[]" placeholder="/mnt/user/Share/...">' +
      '<input type="text" class="plr-sec" name="dir_section[]" placeholder="Section ID">' +
      '<label><input type="checkbox" name="dir_enabled[]" checked> Enabled</label>' +
      '<button type="button" class="btn" onclick="this.closest(\'.plr-dir-block\').remove()">Remove</button>' +
    '</div>' +
    '<div class="plr-plexpath-row">' +
      '<label>Plex\'s own path for this folder:</label>' +
      '<input type="text" name="dir_plex_path[]" placeholder="leave blank if identical to the path above">' +
    '</div>';
  container.appendChild(block);
}
</script>

]]>
</INLINE>
</FILE>

<!--
Monitor daemon: polls configured directories, debounces changes, triggers
a scoped Plex library refresh once a directory has settled.
-->
<FILE Name="/usr/local/emhttp/plugins/&name;/scripts/monitor.sh" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
#
# Plex Media Server Library Refresh - monitor daemon
#
# Polls a set of configured directories for changes (file/folder added or
# removed - detected via a content signature, not just top-level mtime, so
# changes in subfolders are caught too). Once a directory has been quiet
# for SETTLE_SECONDS (no further changes detected), triggers a scoped Plex
# library refresh for that directory's configured section.
#
# Deliberately polling-based rather than inotify-based: Unraid does not
# ship inotify-tools by default, and this avoids requiring an extra
# package (e.g. via NerdPack) just for the plugin to function out of the box.

set -u

# See rc.plexlibraryrefresh for why this is set explicitly.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

CONFIG_DIR="${PLR_CONFIG_DIR:-/boot/config/plugins/plexlibraryrefresh}"
STATE_DIR="${PLR_STATE_DIR:-/var/lib/plexlibraryrefresh}"
# Per-directory change-tracking state lives on the flash drive (under the
# same persistent location as settings), NOT in $STATE_DIR - /var/lib is
# rebuilt fresh on every Unraid boot (and possibly on plugin reinstalls),
# so a daemon restart would otherwise have no memory of "I already know
# this folder, nothing's changed" and would treat the very first
# observation of every watched directory as a fresh change - firing one
# unwarranted refresh per directory on every restart, confirmed as the
# actual cause of exactly that symptom in testing. The write volume here
# is small (a few dozen bytes, only on an actual signature change or
# quiet-poll increment, not every single poll) so this isn't a meaningful
# flash-wear concern.
STATE_PERSIST_DIR="$CONFIG_DIR/state"
CONFIG_FILE="$CONFIG_DIR/settings.cfg"
DIRS_FILE="$CONFIG_DIR/directories.cfg"
LOG_FILE="$STATE_DIR/monitor.log"
PID_FILE="$STATE_DIR/monitor.pid"

mkdir -p "$STATE_DIR" "$STATE_PERSIST_DIR"

log() {
    local level="$1"; shift
    local line
    line="$(date '+%Y-%m-%d %H:%M:%S') [$level] $*"
    echo "$line" >> "$LOG_FILE"
    # Trim only occasionally (once it's noticeably over the cap), not on
    # every single call - "Change detected" can fire every poll cycle for
    # the full duration of an active download, potentially hours, and a
    # full read+rewrite of the log on every one of those calls is wasted
    # work. wc -l is a cheap linear count; the actual rewrite (the
    # expensive part) only happens roughly once every ~200 lines.
    local n
    n="$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)"
    if [ "${n:-0}" -gt 2200 ] 2>/dev/null; then
        tail -n 2000 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv "$LOG_FILE.tmp" "$LOG_FILE"
    fi
}

# ---------------------------------------------------------------- config

load_settings() {
    PLEX_URL=""
    PLEX_TOKEN=""
    POLL_SECONDS=15
    SETTLE_SECONDS=20
    VERIFY_SSL=1
    PLUGIN_ENABLED=1
    # shellcheck disable=SC1090
    [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
}

# directories.cfg format: one entry per line, pipe-delimited:
#   <path>|<plex_section_id>|<enabled 0/1>|<plex_path>
# plex_path is optional - if blank, the local path is sent to Plex
# as-is. Set it whenever Plex runs in its own container with different
# volume mounts (very likely) - it needs the path exactly as ITS OWN
# library section has it configured, not this Unraid host's raw path.
# Blank lines and lines starting with # are ignored.
load_directories() {
    WATCH_PATHS=()
    WATCH_SECTIONS=()
    WATCH_PLEX_PATHS=()
    [ -f "$DIRS_FILE" ] || return
    while IFS='|' read -r path section enabled plex_path; do
        [ -z "$path" ] && continue
        case "$path" in \#*) continue ;; esac
        [ "$enabled" = "0" ] && continue
        WATCH_PATHS+=("$path")
        WATCH_SECTIONS+=("$section")
        WATCH_PLEX_PATHS+=("${plex_path:-$path}")
    done < "$DIRS_FILE"
}

# ---------------------------------------------------------------- plex api

plex_curl_opts=()

build_curl_opts() {
    plex_curl_opts=(-s -m 15)
    if [ "$VERIFY_SSL" != "1" ]; then
        plex_curl_opts+=(-k)
    fi
}

# Pure-bash URL-encoding, matching Python's urllib.parse.quote() defaults
# (verified byte-for-byte identical output across spaces, parens, &, #,
# and multi-byte UTF-8 characters) - avoids spawning a full Python
# interpreter just to encode a path string on every refresh.
urlencode() {
    local s="$1" c i out=""
    for (( i=0; i<${#s}; i++ )); do
        c="${s:i:1}"
        case "$c" in
            [a-zA-Z0-9.~_/-]) out+="$c" ;;
            *) printf -v hex '%%%02X' "'$c"
               out+="$hex" ;;
        esac
    done
    printf '%s' "$out"
}

plex_refresh_path() {
    local section_id="$1"
    local path="$2"
    if [ -z "$PLEX_URL" ] || [ -z "$PLEX_TOKEN" ]; then
        log WARN "Plex URL/token not configured - skipping refresh for $path"
        return 1
    fi
    local encoded_path
    encoded_path="$(urlencode "$path")"
    local url="${PLEX_URL%/}/library/sections/${section_id}/refresh?path=${encoded_path}&X-Plex-Token=${PLEX_TOKEN}"
    local http_code
    http_code="$(curl "${plex_curl_opts[@]}" -o /dev/null -w '%{http_code}' "$url")"
    if [ "$http_code" = "200" ]; then
        log INFO "Triggered Plex refresh for section $section_id, path: $path"
        return 0
    else
        log ERROR "Plex refresh failed for section $section_id, path: $path (HTTP $http_code)"
        return 1
    fi
}

# ---------------------------------------------------------------- signatures

# A cheap content signature for a directory tree: path + size + mtime for
# every entry INSIDE it, hashed. Cheap enough to run every poll cycle even
# for large libraries, and changes (add/remove/modify anywhere in the
# tree) reliably change the hash.
#
# -mindepth 1 excludes the watched directory itself from the signature -
# without it, `find` includes the directory's own entry, so for an EMPTY
# folder the entire signature was based solely on that directory's own
# mtime. On Unraid's /mnt/user (a FUSE-based union filesystem), that
# mtime can change from things unrelated to actual content - mover runs,
# cache activity, etc. - triggering false "change detected" events (and
# eventually a pointless refresh) for a folder nothing was ever added to.
# Confirmed directly: touching only the directory's own metadata changed
# the old signature with zero files involved.
dir_signature() {
    local dir="$1"
    if [ ! -d "$dir" ]; then
        echo "MISSING"
        return
    fi
    find "$dir" -mindepth 1 -printf '%p|%s|%T@\n' 2>/dev/null | sort | md5sum | awk '{print $1}'
}

state_file_for() {
    # Ephemeral, frequently-updated settle-tracking (current signature,
    # when it last changed, how many consecutive quiet polls) - lives in
    # $STATE_DIR (/var/lib, RAM-backed, rebuilt on every boot). This is
    # fine to lose on a restart: worst case, a folder that was mid-settle
    # just re-settles from scratch, a few seconds of extra delay, not a
    # functional problem. Keeping this OUT of the flash-backed location
    # matters because it can be written on every single poll cycle for
    # the full duration of an active, frequently-changing download -
    # potentially hours of continuous writes.
    local dir="$1"
    local safe
    safe="$(echo "$dir" | md5sum | awk '{print $1}')"
    echo "$STATE_DIR/sig_${safe}.state"
}

fired_file_for() {
    # The ONE piece of state that actually needs to survive a reboot:
    # which content signature was last successfully refreshed for. This
    # is what stops a restart from re-firing on unchanged content (the
    # original bug this whole persistence mechanism exists to fix) - and
    # it's written far less often, only at the moment of an actual fire,
    # not on every poll/every detected change. Small, infrequent writes,
    # appropriate for the flash drive.
    local dir="$1"
    local safe
    safe="$(echo "$dir" | md5sum | awk '{print $1}')"
    echo "$STATE_PERSIST_DIR/fired_${safe}.state"
}

# ---------------------------------------------------------------- incomplete-download detection

# Hard veto on top of the settle timer: even once a directory's content
# signature has looked unchanged for SETTLE_SECONDS, a large multi-part
# download (many separate .rXX archive parts, for example) can have
# natural pauses between individual file completions - waiting for peers,
# verifying a piece, etc. - that exceed the settle window, making it look
# "done" when it isn't. If any of these common still-downloading marker
# files exist anywhere in the tree, refuse to fire regardless of how long
# the timer says it's been quiet.
has_incomplete_markers() {
    local dir="$1"
    find "$dir" \( \
        -iname '*.!qb' -o \
        -iname '*.part' -o \
        -iname '*.!ut' -o \
        -iname '*.crdownload' -o \
        -iname '*.downloading' -o \
        -iname '*.bc!' -o \
        -iname '*.dctmp' -o \
        -iname '*.opdownload' \
    \) -print -quit 2>/dev/null
}

# The stronger, more general check: rather than relying on filename
# conventions (which only help for downloaders that use them), directly
# ask the OS whether any process currently has a file open under this
# tree. This catches ANY still-in-progress writer regardless of what's
# doing the writing - a torrent client, but just as importantly a plain
# file copy (e.g. another tool moving a large multi-GB release into this
# same library folder), which has no "incomplete" marker at all and would
# otherwise be invisible to the check above. Only run right before an
# actual fire (not every poll), since it's more expensive than the
# signature hash.
has_open_writers() {
    local dir="$1"
    if command -v lsof >/dev/null 2>&1; then
        # Only WRITE-mode file descriptors count as "still being written
        # to". lsof's FD column ends in 'w' (write-only) or 'u'
        # (read+write) for those; 'r' (read-only) is completely normal
        # for already-finished content being seeded/shared/played -
        # qBittorrent seeding, AirDC++ sharing, and Plex itself reading
        # or scanning a file all hold it open read-only, essentially all
        # the time for anything in an actively-shared library. Treating
        # read-only opens as "still in progress" would mean this almost
        # never clears on a normal setup.
        timeout 10 lsof +D "$dir" 2>/dev/null | awk '$4 ~ /^[0-9]+[wu]$/' | grep -m1 .
        return
    fi
    if command -v fuser >/dev/null 2>&1; then
        # Cruder fallback, only used if lsof isn't available at all:
        # fuser's simple invocation can't reliably distinguish read from
        # write access across implementations, so this may be overly
        # conservative (could delay a refresh) on a folder with actively
        # shared/seeded content. Install/ensure lsof is available for
        # accurate detection - this is a degraded fallback, not the
        # intended primary path.
        local f
        while IFS= read -r -d '' f; do
            if fuser "$f" >/dev/null 2>&1; then
                echo "$f (fuser fallback - can't confirm write vs read access)"
                return
            fi
        done < <(timeout 10 find "$dir" -type f -print0 2>/dev/null)
        return
    fi
    # Neither tool available - can't check, don't block on this signal alone.
}

# ---------------------------------------------------------------- main loop

log INFO "Monitor daemon starting (pid $$)"
echo $$ > "$PID_FILE"

trap 'log INFO "Monitor daemon stopping"; rm -f "$PID_FILE"; exit 0' TERM INT

_plr_was_disabled=0

while true; do
    load_settings

    # "Enable plugin" lets the process keep running (so Start/Stop stay
    # meaningful as separate controls) while pausing all actual watching/
    # refreshing - a lighter-weight pause than stopping the daemon
    # entirely. Logged only on the transition into/out of the disabled
    # state, not every cycle, to avoid spamming the log while paused.
    if [ "$PLUGIN_ENABLED" != "1" ]; then
        if [ "$_plr_was_disabled" != "1" ]; then
            log INFO "Plugin disabled - idling until re-enabled."
            _plr_was_disabled=1
        fi
        sleep "${POLL_SECONDS:-15}"
        continue
    fi
    if [ "$_plr_was_disabled" = "1" ]; then
        log INFO "Plugin re-enabled - resuming."
        _plr_was_disabled=0
    fi

    load_directories
    build_curl_opts

    now="$(date +%s)"

    for i in "${!WATCH_PATHS[@]}"; do
        dir="${WATCH_PATHS[$i]}"
        section="${WATCH_SECTIONS[$i]}"
        plex_path="${WATCH_PLEX_PATHS[$i]}"
        state_file="$(state_file_for "$dir")"
        fired_file="$(fired_file_for "$dir")"

        current_sig="$(dir_signature "$dir")"

        prev_sig=""
        prev_changed_at=""
        quiet_polls=0
        if [ -f "$state_file" ]; then
            # shellcheck disable=SC1090
            source "$state_file"
        fi
        fired_sig=""
        if [ -f "$fired_file" ]; then
            # shellcheck disable=SC1090
            source "$fired_file"
        fi

        if [ "$current_sig" != "$prev_sig" ]; then
            # A real change - reset the elapsed-time clock and the
            # consecutive-quiet-poll counter. Ephemeral write only.
            {
                echo "prev_sig='$current_sig'"
                echo "prev_changed_at=$now"
                echo "quiet_polls=0"
            } > "$state_file"
            log DEBUG "Change detected under: $dir"
            continue
        fi

        # Unchanged from last poll. If we've ALREADY successfully fired a
        # refresh for this exact content signature, there is nothing to
        # do - stop here without touching quiet_polls/prev_changed_at at
        # all. This is the critical guard: without it, a fire would
        # otherwise re-arm its own timer (by resetting prev_changed_at to
        # the firing moment) and the settle-then-fire cycle would just
        # repeat forever on a fixed interval even with a completely
        # static, unchanged folder - confirmed as a real bug in testing,
        # not just a theoretical concern.
        if [ "$current_sig" = "$fired_sig" ]; then
            continue
        fi

        quiet_polls=$(( quiet_polls + 1 ))
        elapsed=$(( now - prev_changed_at ))

        # Firing requires ALL of:
        #  1. elapsed >= SETTLE_SECONDS
        #  2. at least 2 INDEPENDENT quiet polls, not just 1 - guards
        #     against SETTLE_SECONDS being configured close to (or
        #     smaller than) POLL_SECONDS, which would otherwise let a
        #     single quiet poll satisfy the elapsed check trivially.
        #  3. no incomplete-download marker present (helps for
        #     downloaders that use one)
        #  4. no process currently has a file open FOR WRITING under this
        #     tree (read-only opens - seeding, sharing, playback/scanning
        #     - are ignored and never block a refresh)
        if [ "$elapsed" -ge "$SETTLE_SECONDS" ] && [ "$quiet_polls" -ge 2 ]; then
            marker="$(has_incomplete_markers "$dir")"
            writer="$([ -z "$marker" ] && has_open_writers "$dir")"
            if [ -n "$marker" ]; then
                log DEBUG "Still waiting under $dir - incomplete-download marker present: $marker"
                { echo "prev_sig='$current_sig'"; echo "prev_changed_at=$prev_changed_at"; echo "quiet_polls=$quiet_polls"; } > "$state_file"
            elif [ -n "$writer" ]; then
                log DEBUG "Still waiting under $dir - a process still has a file open there: $writer"
                { echo "prev_sig='$current_sig'"; echo "prev_changed_at=$prev_changed_at"; echo "quiet_polls=$quiet_polls"; } > "$state_file"
            else
                if [ -n "$section" ]; then
                    plex_refresh_path "$section" "$plex_path"
                else
                    log WARN "No Plex section configured for $dir - skipping refresh."
                fi
                # The ONE flash write per fire event - records that THIS
                # signature has now been refreshed, which is what stops
                # a future restart from re-firing on the same unchanged
                # content.
                echo "fired_sig='$current_sig'" > "$fired_file"
                { echo "prev_sig='$current_sig'"; echo "prev_changed_at=$now"; echo "quiet_polls=0"; } > "$state_file"
            fi
        else
            # Not ready to fire yet - persist the incremented quiet-poll
            # count so it keeps accumulating across cycles. Ephemeral
            # write only.
            { echo "prev_sig='$current_sig'"; echo "prev_changed_at=$prev_changed_at"; echo "quiet_polls=$quiet_polls"; } > "$state_file"
        fi
    done

    sleep "$POLL_SECONDS"
done

]]>
</INLINE>
</FILE>

<!--
Service control script (start/stop/restart/status).
-->
<FILE Name="/etc/rc.d/rc.&name;" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
#
# Plex Media Server Library Refresh - service control script
# Usage: rc.plexlibraryrefresh {start|stop|restart|status}

# Web-server-invoked processes (PHP's shell_exec/exec) often run with a much
# more restricted PATH than an interactive SSH session - bare commands like
# pgrep/xargs/nohup can silently fail to be found otherwise. Make sure the
# standard locations are always searched regardless of the caller's PATH.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

DAEMON="/usr/local/emhttp/plugins/plexlibraryrefresh/scripts/monitor.sh"
STATE_DIR="/var/lib/plexlibraryrefresh"
PID_FILE="$STATE_DIR/monitor.pid"

mkdir -p "$STATE_DIR"

# Matches on the actual command line, not just a PID number, so a stale PID
# file pointing at a since-reused PID (e.g. after a plugin reinstall killed
# the daemon without updating the PID file) is never mistaken for "running".
#
# The pattern brackets one character ([m]onitor.sh rather than
# monitor.sh) - a standard trick to stop pgrep -f from matching its own
# invocation. Without it, pgrep matches ANY process whose command line
# contains the search text, which includes the shell wrapper PHP/this
# script itself spawns to run pgrep - a confirmed false positive that
# made the daemon appear permanently "running" regardless of its real
# state.
DAEMON_PATTERN="/usr/local/emhttp/plugins/plexlibraryrefresh/scripts/[m]onitor.sh"

pids_running() {
    pgrep -f "$DAEMON_PATTERN" 2>/dev/null
}

is_running() {
    [ -n "$(pids_running)" ]
}

start() {
    if is_running; then
        echo "Already running (pid(s): $(pids_running | tr '\n' ' '))."
        return 0
    fi
    nohup "$DAEMON" >> "$STATE_DIR/monitor_stdout.log" 2>&1 &
    disown
    sleep 1
    if is_running; then
        echo "Started (pid $(pids_running | tr '\n' ' '))."
    else
        echo "Failed to start - check $STATE_DIR/monitor_stdout.log"
        return 1
    fi
}

stop() {
    local pids
    pids="$(pids_running)"
    if [ -z "$pids" ]; then
        echo "Not running."
        rm -f "$PID_FILE"
        return 0
    fi
    # Kill EVERY matching process, not just the one in the PID file - if a
    # previous stop was silently blocked (e.g. by the CSRF bug in an
    # earlier version), more than one instance may be running.
    echo "$pids" | xargs -r kill 2>/dev/null
    for _ in $(seq 1 10); do
        is_running || break
        sleep 0.5
    done
    if is_running; then
        echo "$(pids_running)" | xargs -r kill -9 2>/dev/null
    fi
    rm -f "$PID_FILE"
    echo "Stopped."
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status)
        if is_running; then
            echo "Running (pid(s): $(pids_running | tr '\n' ' '))."
        else
            echo "Stopped."
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

]]>
</INLINE>
</FILE>

<!--
Install-time (and boot-time re-apply) actions: ensure directories exist,
correct permissions, start the daemon.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
set -e
mkdir -p /boot/config/plugins/plexlibraryrefresh
mkdir -p /var/lib/plexlibraryrefresh
mkdir -p /usr/local/emhttp/plugins/plexlibraryrefresh/scripts
chmod 0755 /usr/local/emhttp/plugins/plexlibraryrefresh/scripts/monitor.sh
chmod 0755 /etc/rc.d/rc.plexlibraryrefresh

# Idempotent: on boot, Unraid re-applies this plugin's FILE entries and
# re-runs this script - if the daemon is already running (shouldn't be,
# fresh boot, but harmless either way) this just reports that and exits 0.
/etc/rc.d/rc.plexlibraryrefresh start || true

echo ""
echo "-----------------------------------------------------------------"
echo " Plex Library Refresh installed."
echo " Configure it under Settings -> Plex Library Refresh in the webGUI."
echo "-----------------------------------------------------------------"

]]>
</INLINE>
</FILE>

<!--
Uninstall actions (Method="remove" - run when the plugin is removed via
the webGUI's Plugins tab, not on install/update).
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
/etc/rc.d/rc.plexlibraryrefresh stop || true
rm -rf /usr/local/emhttp/plugins/plexlibraryrefresh
rm -f /etc/rc.d/rc.plexlibraryrefresh
# Deliberately NOT removing /boot/config/plugins/plexlibraryrefresh (settings)
# or /var/lib/plexlibraryrefresh (logs) - so a reinstall picks up prior config.
# Remove manually if you want a truly clean uninstall:
#   rm -rf /boot/config/plugins/plexlibraryrefresh /var/lib/plexlibraryrefresh
echo "Plex Library Refresh removed (settings kept for a possible reinstall)."

]]>
</INLINE>
</FILE>

</PLUGIN>
